# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# App login hardening (server-side lockout)
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
# Local-only escape hatch (never enable in production)
# AUTH_LOGIN_RATE_LIMIT_DISABLED=false
# For running DB migrations (scripts in scripts/). Optional if you use supabase.env instead.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Flow mode enforcement (default: schema — identical to pre–Phase 5 behavior)
# schema   — mode chips hide tools from the LLM schema (*_BLOCKED_TOOLS)
# advisory — mode still biases the system prompt; tools are NOT filtered
# off      — mode ignored in prompt and tool schema; intent-based runtime guards only
# FLOW_MODE_ENFORCEMENT=schema

# Anthropic Claude (for AI assistant)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional server default override (default: claude-sonnet-4-6; users can toggle to Opus in chat UI)
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=16384
# Prompt caching (ephemeral 5-min TTL) on stable system prompts and tool schemas (default: true)
# ANTHROPIC_PROMPT_CACHE_ENABLED=true

# Gemini (partnership web research enrichment on pipeline / target list)
GEMINI_API_KEY=your_gemini_api_key
# Primary model (default: gemini-2.5-flash)
# GEMINI_PARTNERSHIPS_MODEL=gemini-2.5-flash
# Comma-separated fallbacks when primary is overloaded (default: gemini-2.0-flash)
# GEMINI_PARTNERSHIPS_FALLBACK_MODELS=gemini-2.0-flash
# Partnership research backend:
# - legacy (default when TAVILY/SERP/CSE is set): web search + Gemini synthesis
# - grounded: Gemini + Google Search tool grounding only
# PARTNERSHIP_RESEARCH_BACKEND=legacy
# Delay between companies for bulk target-list research (ms, default 2500)
# PARTNERSHIP_RESEARCH_BULK_DELAY_MS=2500
# Note: grounding with Google Search is billed per search query the model executes.
# Web Enrichment (default: Tavily)
TAVILY_API_KEY=your_tavily_key
ENRICH_PROVIDER=tavily

# Optional: SERP API or Google CSE
# SERPAPI_API_KEY=your_serpapi_key
# GOOGLE_CSE_API_KEY=your_google_cse_key
# GOOGLE_CSE_CX=your_google_cse_cx

# Apollo.io (CRM contact discovery — master API key required for People API Search)
APOLLO_API_KEY=your_master_apollo_api_key
APOLLO_ENABLED=true
APOLLO_ALLOW_EMAIL_REVEAL=true
APOLLO_ALLOW_PHONE_REVEAL=true
# Public HTTPS base URL for Apollo phone-reveal webhooks (required for personal/mobile numbers)
# Use your stable production domain — localhost cannot receive Apollo callbacks
APOLLO_WEBHOOK_BASE_URL=https://agentdash-ten.vercel.app
# Optional shared secret validated on /api/apollo/webhooks/phone?token=...
# APOLLO_WEBHOOK_SECRET=generate_a_long_random_string
APOLLO_MAX_PEOPLE_PER_REQUEST=25
# Optional: apollo | tavily | serpapi | google_cse (defaults to apollo when APOLLO_API_KEY is set)
# COMPANY_DISCOVERY_PROVIDER=tavily
# APOLLO_MAX_SEEDS_PER_EXPAND=3
# APOLLO_MAX_RESULTS_PER_SEED=10

# Finnhub (public company stock quotes for firmographics Investigate)
# FINNHUB_API_KEY=your_finnhub_api_key

# Meta Ad Library (optional — enriches Meta ads signals on Investigate)
# META_ACCESS_TOKEN=your_meta_graph_api_token

# Admin bootstrap script (required for scripts/create-admin.mjs)
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=change_me_before_running
