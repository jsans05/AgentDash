# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# For running DB migrations (scripts in scripts/). Optional if you use supabase.env instead.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# OpenAI (for AI assistant)
OPENAI_API_KEY=your_openai_key

# CreatorIQ (Cycle environment: use Cycle API key + CREATORIQ_ORG_NAME=Cycle)
CREATORIQ_API_KEY=your_creatoriq_key
CREATORIQ_BASE_URL=https://apis.creatoriq.com
# Org/tenant (try division name if 403): Cycle, or Wasserman to match "Select Division"
CREATORIQ_ORG_NAME=Wasserman
# Optional: if API expects division separately (e.g. Wasserman)
# CREATORIQ_DIVISION=Wasserman

# Web Enrichment (default: Tavily)
TAVILY_API_KEY=your_tavily_key
ENRICH_PROVIDER=tavily

# Optional: SERP API or Google CSE
# SERPAPI_API_KEY=your_serpapi_key
# GOOGLE_CSE_API_KEY=your_google_cse_key
# GOOGLE_CSE_CX=your_google_cse_cx
